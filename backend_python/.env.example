# Copy this file to backend_python/.env and set values for your environment.
HOST=127.0.0.1
PORT=8000
DATABASE_URL=
DATABASE_SSLMODE=require
# Must be at least 32 bytes; generate and keep private.
JWT_SECRET=
JWT_EXPIRES_MINUTES=480
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
UPLOAD_DIR=
MAX_UPLOAD_BYTES=524288000
