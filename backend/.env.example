# =====================================================================
# CINE RETRO - Variaveis de ambiente (banco de dados REMOTO / cloud)
# Nao e necessario instalar MySQL/PostgreSQL localmente nem usar Docker.
# Basta criar um banco Postgres gratuito em um destes provedores:
#   - Supabase   -> https://supabase.com          (recomendado)
#   - Railway    -> https://railway.app
#   - Neon       -> https://neon.tech
#   - Render     -> https://render.com
# Copie a "Connection String" (URI) fornecida pelo provedor para DATABASE_URL.
# =====================================================================

# Porta em que o servidor Express vai rodar
PORT=3000

# String de conexao do banco Postgres remoto (copie do painel do provedor)
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://usuario:senha@host.supabase.co:5432/postgres

# A maioria dos provedores cloud exige SSL. Mantenha "true" para
# Supabase, Railway, Neon e Render. Use "false" apenas se seu provedor
# remoto explicitamente nao usar/exigir SSL.
DB_SSL=true

# Segredo usado para assinar os tokens JWT (troque em producao)
JWT_SECRET=cine_retro_super_segredo_troque_isso
JWT_EXPIRES_IN=8h